# Slipstream distribution config — Windows x64 AVX2.
# Base: third_party/thorium/other/AVX2/win_AVX2_args.gn @ M152.0.7977.55
# Slipstream deltas are marked [SLIP]; rationale in docs/DECISIONS.md.
# Diff this against Thorium's file on every tag bump.
# NOTE: used from v0.1 on. The v0.0 stock gate builds with Thorium's file verbatim.

thorium_x86_profile = "avx2_fma"
target_os = "win"
target_cpu = "x64"
is_official_build = true
is_debug = false
enable_stripping = true
thin_lto_enable_cache = false
dcheck_always_on = false
exclude_unwind_tables = true
enable_iterator_debugging = false
disable_fieldtrial_testing_config = true
enable_reporting = false
enable_resource_allowlist_generation = false
enable_profiling = false
is_component_build = false
symbol_level = 0
optimize_webui = true
is_clang = true
treat_warnings_as_errors = false
win_enable_cfg_guards = true
use_lld = true
v8_symbol_level = 0
v8_enable_fast_torque = true
v8_enable_builtins_optimization = true
v8_enable_maglev = true
v8_enable_turbofan = true
v8_enable_wasm_simd256_revec = true
use_v8_context_snapshot = true
blink_symbol_level = 0
enable_precompiled_headers = false
media_use_ffmpeg = true
media_use_libvpx = true
enable_hls_demuxer = true
proprietary_codecs = true
ffmpeg_branding = "Chrome"
clang_use_chrome_plugins = true
enable_ffmpeg_video_decoders = true
is_component_ffmpeg = true      # [SLIP] was false — separate ffmpeg.dll, clean LGPL posture
enable_library_cdms = true
enable_widevine = true
bundle_widevine_cdm = false     # [SLIP] was true — component updater fetches CDM at runtime
enable_cdm_storage_id = true
enable_media_drm_storage = true
enable_rlz = false              # [SLIP] was true — compile out Google install-attribution
enable_hangout_services_extension = false
rtc_use_h264 = true
rtc_use_h265 = true
rtc_build_examples = false
rtc_enable_avx2 = true
enable_vr = true                # [SLIP] review candidate for v0.1 — likely false
enable_platform_hevc = true
enable_hevc_parser_and_hw_decoder = true
platform_has_optional_hevc_decode_support = true
platform_has_optional_hevc_encode_support = true
enable_platform_ac3_eac3_audio = true
enable_platform_ac4_audio = false
enable_platform_dolby_vision = true
enable_platform_encrypted_dolby_vision = true
enable_platform_mpeg_h_audio = true
enable_platform_dts_audio = true
enable_mse_mpeg2ts_stream_parser = true
use_text_section_splitting = true
use_thin_lto = true
thin_lto_enable_optimizations = true
enable_rust = true
chrome_pgo_phase = 2

# [SLIP] additions — verify each exists in the pinned milestone via
# docs/gn_all_args.txt before every release (the GN arg surface churns)
enable_background_mode = false
enable_background_contents = false
enable_service_discovery = false

# INVARIANT (docs/PILLARS.md C2): enable_mdns=false compiles out the mDNS
# responder that conceals local IPs in WebRTC ICE candidates. It is only
# valid while the webrtc.ip_handling_policy=default_public_interface_only
# default (PRIV-02, 90-default-prefs-hardening.patch) ships in the same
# build. Revert PRIV-02 => revert this to true in the same commit.
enable_mdns = false

# [SLIP] pillar pins (docs/PILLARS.md section A) — assert-pins: these are
# already the defaults for this config; pinning makes drift a gen-time error.
v8_enable_pointer_compression = true   # MEM-07 (v8/BUILD.gn)
v8_enable_sandbox = true               # SEC-V8SBX-11
enable_backup_ref_ptr_support = true   # MEM-08: security kept over ~memory cost

# MEM-09 — gated: requires trial build + CWS smoke green, else defer to v0.2
use_on_device_model_service = false
